# Copy this file to .env and adjust as needed.
# For local development we use SQLite (a single file, no server needed).
# To switch to PostgreSQL later, change this to:
#   postgresql+psycopg://user:password@localhost:5432/veya
DATABASE_URL=sqlite:///./veya.db

# ניתוח סקיצת אולם ב-AI Vision (POST /hall/sketch/analyze, ראה hall_vision.py).
# בלי המפתח הזה הפיצ'ר "בניית אולם מסקיצה" מחזיר שגיאה ברורה בעברית
# ("ניתוח AI אינו מוגדר בשרת") — כל שאר המערכת עובדת כרגיל.
# המפתח נוצר ב-console.anthropic.com ← API Keys.
ANTHROPIC_API_KEY=

# WhatsApp — מצב שליחה (ראו docs/whatsapp-meta.md). ברירת המחדל הבטוחה: mock.
#   mock      — שום הודעה לא יוצאת; נרשמת ביומן בלבד.
#   meta_test — שליחה אמיתית דרך Meta, רק לטלפונים שב-WHATSAPP_TEST_RECIPIENTS.
#   meta      — שליחה אמיתית לכל המוזמנים (רק אחרי אישור מפורש).
# ערך חסר או לא מוכר = mock.
WHATSAPP_MODE=mock
# במצב meta_test בלבד: הטלפונים המורשים, מופרדים בפסיק (05X / 972 / +972).
# ריק = כל שליחה חסומה.
WHATSAPP_TEST_RECIPIENTS=
# פרטי חשבון Meta (רק ב-meta_test / meta). לא להעתיק לכאן ערכים אמיתיים —
# הערכים נכנסים רק ל-backend/.env (מוחרג מ-git), לעולם לא לקובץ הזה.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# ה-webhook: מחרוזת שאתם ממציאים (ומזינים גם ב-Meta), וסוד האפליקציה מ-Meta.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# ריק = v26.0
WHATSAPP_GRAPH_API_VERSION=
# 1 = ה-webhook שומר הודעות נכנסות (כ"דורש טיפול"). כבוי — עדכוני סטטוס בלבד;
# הודעה נכנסת לא נשמרת ולא נוגעת בשום נתון.
WHATSAPP_WEBHOOK_INBOUND=
# 1 = לחיצת כפתור "מגיע/ה" ב-WhatsApp מעדכנת RSVP (רק כשגם WHATSAPP_WEBHOOK_INBOUND=1).
# כבוי — אישור הגעה רק בקישור האישי.
WHATSAPP_INBOUND_RSVP=
