{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run build:legal && npm run build:brand && npm run build:site",
    "build": "tsc -b && vite build",
    "build:legal": "node scripts/build-legal-pages.mjs",
    "preview": "vite preview",
    "test:hall-sketch-geometry": "tsc --project tsconfig.testgeom.json && echo '{\"type\":\"commonjs\"}' > .tmp-test/package.json && node .tmp-test/hallSketchGeometry.test.js && rm -rf .tmp-test",
    "test:seating-workspace": "tsc --project tsconfig.testworkspace.json && echo '{\"type\":\"commonjs\"}' > .tmp-test-ws/package.json && node .tmp-test-ws/seatingWorkspace.test.js && rm -rf .tmp-test-ws",
    "build:site": "node scripts/build-site-pages.mjs",
    "build:brand": "node scripts/inject-brand-layer.mjs"
  },
  "dependencies": {
    "@react-oauth/google": "^0.12.1",
    "@supabase/supabase-js": "^2.45.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "marked": "^18.0.7",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
